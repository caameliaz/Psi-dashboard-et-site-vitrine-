generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CATÉGORIE ───────────────────────────────────────────────────────────────
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  photo       String?
  description String?
  prefix      String?   // préfixe des références produit auto (ex: PTT, IMP)
  refCounter  Int       @default(0) // dernier numéro utilisé pour l'auto-incrément
  order       Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
}

// ─── SECTEUR D'ACTIVITÉ CLIENT ───────────────────────────────────────────────
model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  clients   Client[]
  createdAt DateTime @default(now())
}

// ─── PRODUIT ─────────────────────────────────────────────────────────────────
model Product {
  id           String               @id @default(cuid())
  reference    String               @unique
  name         String?              // nom personnalisable du produit (facultatif)
  width        Int                  // largeur en mm
  length       Int                  // longueur en m
  metrage      Float?               // longueur en mètres (facultatif)
  usage        String
  price        Float
  photo        String?
  active       Boolean              @default(true)
  category     Category             @relation(fields: [categoryId], references: [id])
  categoryId   String
  customFields ProductCustomField[]
  orderItems   OrderItem[]
  quoteItems   QuoteItem[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

// Valeurs des champs custom pour chaque produit
model ProductCustomField {
  id           String          @id @default(cuid())
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  definition   ProductFieldDef @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  definitionId String
  value        String

  @@unique([productId, definitionId])
}

// Définition des champs custom (créés par l'admin depuis les paramètres)
model ProductFieldDef {
  id        String               @id @default(cuid())
  label     String               // ex: "Grammage", "Diamètre mandrin"
  type      FieldType            @default(TEXT)
  required  Boolean              @default(false)
  order     Int                  @default(0)
  values    ProductCustomField[]
  createdAt DateTime             @default(now())
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
}

// ─── CLIENT ──────────────────────────────────────────────────────────────────
model Client {
  id        String           @id @default(cuid())
  name      String
  company   String?
  email     String?
  wilaya    String
  commune   String?
  address   String?
  photo     String?
  sector    Sector?          @relation(fields: [sectorId], references: [id])
  sectorId  String?          // secteur d'activité (pharmacie, banque…)
  // Désactivation (au lieu d'une suppression réelle — l'historique reste)
  active            Boolean   @default(true)
  deactivatedReason String?
  deactivatedById   String?
  deactivatedBy     User?     @relation("ClientDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivatedAt     DateTime?
  phones    ClientPhone[]
  orders    Order[]
  quotes    Quote[]
  contacts  ContactRequest[]
  notes     ClientNote[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

// Numéros de téléphone (plusieurs par client, chacun avec un label)
model ClientPhone {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  number    String
  label     String   @default("Principal") // ex: "Secrétaire", "Directeur", "Mobile"
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Notes internes sur un client (visibles dans la fiche client)
model ClientNote {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  author    User     @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

// Notes internes sur une commande OU un devis (fil horodaté, visible par tous)
model RequestNote {
  id        String   @id @default(cuid())
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId   String?
  author    User     @relation("RequestNoteAuthor", fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

// ─── COMMANDE ────────────────────────────────────────────────────────────────
model Order {
  id              String         @id @default(cuid())
  ref             String?        @unique
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId        String?
  clientName      String?        // snapshot au moment de la création
  clientCompany   String?
  clientWilaya    String?
  items           OrderItem[]
  status          RequestStatus  @default(EN_ATTENTE)
  source          OrderSource    @default(SITE)
  cancelReason    String?
  notes           String?
  createdBy     User?          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdById   String?        // null si commande du site public
  assignedTo    User?          @relation("OrderAssignedTo", fields: [assignedToId], references: [id])
  assignedToId  String?        // "pris en charge par"
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditOrder")
  requestNotes  RequestNote[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?
  description String?  // réf libre (hors catalogue)
  metrage     Float?   // longueur en mètres (facultatif)
  quantity    Int
  unitPrice   Float   // snapshot du prix au moment de la commande
}

enum OrderSource {
  SITE
  ADMIN
  WHATSAPP
  TELEPHONE
  AUTRE
}

// ─── DEVIS ───────────────────────────────────────────────────────────────────
model Quote {
  id               String         @id @default(cuid())
  ref              String?        @unique
  client           Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId         String?
  clientName       String?        // snapshot au moment de la création
  clientCompany    String?
  clientWilaya     String?
  items            QuoteItem[]
  message          String         // description libre du client
  status           RequestStatus  @default(EN_ATTENTE)
  source           OrderSource    @default(SITE)
  cancelReason     String?
  // Champs admin (remplis après discussion avec le client)
  proposedPrice    Float?
  deliveryDelay    String?        // ex: "5 à 7 jours"
  paymentTerms     String?        // ex: "50% à la commande"
  adminRemarks     String?
  notes            String?        // notes internes
  createdBy        User?          @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  createdById      String?
  assignedTo       User?          @relation("QuoteAssignedTo", fields: [assignedToId], references: [id])
  assignedToId     String?        // "pris en charge par"
  notifications    Notification[]
  auditLogs        AuditLog[]     @relation("AuditQuote")
  requestNotes     RequestNote[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model QuoteItem {
  id          String   @id @default(cuid())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String
  product     Product? @relation(fields: [productId], references: [id])
  productId   String?
  description String?  // si produit hors catalogue ou format spécial
  width       Int?
  length      Int?
  metrage     Float?   // longueur en mètres (facultatif)
  quantity    Int
}

enum RequestStatus {
  EN_ATTENTE
  CONTACTE
  VALIDE
  LIVRE
  ANNULE
}

// ─── CONTACT ─────────────────────────────────────────────────────────────────
// Les messages de contact n'ont pas de cancelReason — on les traite ou pas, pas d'annulation
model ContactRequest {
  id        String        @id @default(cuid())
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  message   String
  status    ContactStatus @default(EN_ATTENTE)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ContactStatus {
  EN_ATTENTE
  TRAITE
}

// ─── STATUTS PERSONNALISÉS ───────────────────────────────────────────────────
model CustomStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   // ex: "#F59E0B"
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── TEMPLATES MESSAGES ──────────────────────────────────────────────────────
model MessageTemplate {
  id        String           @id @default(cuid())
  title     String
  content   String           // avec variables : [Nom], [Référence], [Wilaya]
  category  TemplateCategory @default(AUTRE)
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

enum TemplateCategory {
  CONFIRMATION
  RELANCE
  LIVRAISON
  DEVIS
  AUTRE
}

// ─── CONTENU SITE ────────────────────────────────────────────────────────────
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── UTILISATEUR ADMIN ───────────────────────────────────────────────────────
model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
}

model User {
  id              String             @id @default(cuid())
  name            String
  email           String             @unique
  password        String
  role            Role               @default(EMPLOYEE)
  active          Boolean            @default(true)
  phone           String?
  photo           String?
  permissions     String[]           @default([])
  sessionVersion  Int                @default(0) // incrémenté pour invalider tous les cookies
  resetRequested  Boolean            @default(false) // l'utilisateur a demandé une réinit. de mot de passe
  resetRequestedAt DateTime?
  twoFactorCode     String?          // code 2FA à 6 chiffres en attente de validation (usage unique)
  twoFactorExpires  DateTime?        // expiration du code 2FA (5 min)
  twoFactorAttempts Int      @default(0) // tentatives échouées sur le code courant (invalide après 5)
  recapDaily      Boolean            @default(true)  // reçoit le récap quotidien (20h) — désactivable dans le profil
  recapWeekly     Boolean            @default(true)  // reçoit le bilan hebdomadaire (jeudi 23h59)
  ordersCreated   Order[]            @relation("OrderCreatedBy")
  quotesCreated   Quote[]            @relation("QuoteCreatedBy")
  ordersAssigned  Order[]            @relation("OrderAssignedTo")
  quotesAssigned  Quote[]            @relation("QuoteAssignedTo")
  clientNotes     ClientNote[]       @relation("ClientNoteAuthor")
  clientsDeactivated Client[]        @relation("ClientDeactivatedBy")
  requestNotes    RequestNote[]      @relation("RequestNoteAuthor")
  notifications   NotificationRead[]
  auditLogs       AuditLog[]
  pushSubscriptions PushSubscription[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

enum Role {
  ADMIN
  EMPLOYEE
}

// ─── ABONNEMENTS PUSH (notifications système Web Push) ───────────────────────
// Un abonnement = un appareil/navigateur d'un utilisateur.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── OBJECTIFS MENSUELS (montant de ventes en DA) ────────────────────────────
// userId null = objectif GLOBAL de l'entreprise ; sinon objectif d'un commercial.
// Un seul objectif par (month, userId) grâce à l'index unique.
model MonthlyGoal {
  id        String   @id @default(cuid())
  month     String   // format "YYYY-MM"
  userId    String?  // null = objectif global entreprise
  amount    Float    // montant cible en DA
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, userId])
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────
model Notification {
  id        String             @id @default(cuid())
  type      NotifType
  title     String
  message   String
  orderId   String?
  quoteId   String?
  clientId  String?            // pour deep-link vers la fiche client (ex: client désactivé)
  link      String?            // lien libre (ex: '/admin/dashboard' pour les objectifs)
  order     Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  quote     Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  reads     NotificationRead[]
  createdAt DateTime           @default(now())
}

// Suivi de lecture par utilisateur (chacun a son propre état lu/non lu)
model NotificationRead {
  id             String       @id @default(cuid())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  read           Boolean      @default(false)
  readAt         DateTime?

  @@unique([notificationId, userId])
}

enum NotifType {
  SITE_COMMANDE // bleu — nouvelle commande site public
  SITE_DEVIS    // bleu — nouveau devis site public
  ACTION_PERSO  // gris — action de l'utilisateur lui-même
  ACTION_AUTRE  // orange — action d'un autre utilisateur (admin only)
  ANNULATION    // rouge — annulation proposée (admin only)
}

// ─── HISTORIQUE DES ACTIONS ──────────────────────────────────────────────────
model AuditLog {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  action    String      // ex: "Commande validée", "Produit modifié"
  entity    AuditEntity
  entityId  String?     // id de l'entité concernée
  detail    String?
  orderId   String?
  quoteId   String?
  order     Order?      @relation("AuditOrder", fields: [orderId], references: [id], onDelete: SetNull)
  quote     Quote?      @relation("AuditQuote", fields: [quoteId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
}

enum AuditEntity {
  COMMANDE
  DEVIS
  PRODUIT
  CLIENT
  UTILISATEUR
  CONTENU
  TEMPLATE
  STATUT
}
